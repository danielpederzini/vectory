# Copy to .env and adjust for your environment.

# --- Image tags ---
JDK_IMAGE=eclipse-temurin:25-jdk
JRE_IMAGE=eclipse-temurin:25-jre
# pgvector superset of postgres:17, required by recommendation-manager.
POSTGRES_IMAGE=pgvector/pgvector:pg17
KAFKA_IMAGE=apache/kafka:4.0.0

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# --- JWT (user-manager) ---
# Must be at least 32 bytes for HS256.
JWT_SECRET=change-me-please-use-a-32-byte-minimum-secret
JWT_TTL=PT1H

# --- Embeddings (recommendation-manager) ---
# OpenAI-compatible endpoint; works with OpenAI, Google Gemini, Ollama, LM Studio, etc.
# The request URL is BASE_URL + PATH.
#   OpenAI:  base=https://api.openai.com                              path=/v1/embeddings
#   Gemini:  base=https://generativelanguage.googleapis.com/v1beta/openai  path=/embeddings
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_PATH=/embeddings
EMBEDDING_API_KEY=
# Gemini text embeddings (free tier). text-embedding-3-small for OpenAI.
EMBEDDING_MODEL=gemini-embedding-001
# Must match the vector() column dimension in the Flyway migration.
EMBEDDING_DIMENSIONS=768
USER_EMBEDDING_ALPHA=0.2
CRON_FIXED_DELAY=PT5M
CRON_BATCH_SIZE=500

# --- Host port mappings ---
CONTENT_MANAGER_PORT=8080
USER_MANAGER_PORT=8081
KAFKA_EXTERNAL_PORT=29092
