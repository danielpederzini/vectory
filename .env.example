# Copy to .env and adjust for your environment.

# --- Image tags ---
JDK_IMAGE=eclipse-temurin:25-jdk
JRE_IMAGE=eclipse-temurin:25-jre
# pgvector superset of postgres:17, required by recommendation-manager.
POSTGRES_IMAGE=pgvector/pgvector:pg17
KAFKA_IMAGE=apache/kafka:4.0.0

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# --- JWT (user-manager) ---
# Must be at least 32 bytes for HS256.
JWT_SECRET=change-me-please-use-a-32-byte-minimum-secret
JWT_TTL=PT1H

# --- Embeddings (recommendation-manager) ---
# Multimodal embeddings via Jina (jina-clip-v2): posts are embedded from their
# text and image together. The request URL is BASE_URL + PATH.
# Get a free API key at https://jina.ai/embeddings and set EMBEDDING_API_KEY.
EMBEDDING_BASE_URL=https://api.jina.ai
EMBEDDING_PATH=/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=jina-clip-v2
# Must match the vector() column dimension in the Flyway migration.
EMBEDDING_DIMENSIONS=1024
USER_EMBEDDING_ALPHA=0.2
CRON_FIXED_DELAY=PT5M
CRON_BATCH_SIZE=500

# --- Feed ranking (recommendation-manager) ---
FEED_CANDIDATE_LIMIT=500
FEED_DEFAULT_LIMIT=20
FEED_MAX_LIMIT=50
FEED_RECENCY_HALF_LIFE=P7D
FEED_SEMANTIC_WEIGHT=0.65
FEED_RECENCY_WEIGHT=0.25
FEED_POPULARITY_WEIGHT=0.10

# --- Object storage (content-manager media uploads) ---
# S3-compatible. Defaults target the bundled MinIO service. The code is
# provider-agnostic: to use a cloud provider, change the values below.
#   Cloudflare R2: endpoint=https://<accountid>.r2.cloudflarestorage.com  region=auto  path-style=true
#   Backblaze B2:  endpoint=https://s3.<region>.backblazeb2.com           region=<region>
#   Supabase:      endpoint=https://<ref>.storage.supabase.co/storage/v1/s3  region=<region>
# For a cloud provider, set STORAGE_PUBLIC_ENDPOINT equal to STORAGE_ENDPOINT.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=vectory-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PATH_STYLE=true
STORAGE_PRESIGN_PUT_TTL=PT10M
STORAGE_PRESIGN_GET_TTL=PT15M
STORAGE_MAX_IMAGE_BYTES=10485760

# --- Host port mappings ---
CONTENT_MANAGER_PORT=8080
USER_MANAGER_PORT=8081
RECOMMENDATION_MANAGER_PORT=8082
KAFKA_EXTERNAL_PORT=29092
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
